datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../app/enterprise/coleman/lib/generated/prisma"
}

model Track {
  id          String   @id @default(uuid())
  title       String
  artist      String?
  musicalKey  String   @default("—")
  bpm         Int      @default(0)
  serviceName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Production stems (maps to Stem in API docs — stored as AudioAsset rows)
  audioFiles  AudioAsset[]
  historyLogs PlaybackHistory[]
}

model AudioAsset {
  id         String   @id @default(uuid())
  filename   String   @unique
  originName String
  stemType   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model TheoryProgression {
  id          String   @id @default(uuid())
  name        String
  numbers     String
  chords      String
  description String?
  createdAt   DateTime @default(now())
}

model WorshipLookup {
  id        String @id @default(uuid())
  songTitle String @unique
  artist    String
  targetKey String
  targetBpm Int
  roadmap   String
}

model PlaybackHistory {
  id       String   @id @default(uuid())
  playedAt DateTime @default(now())

  trackId String
  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model AudioRoutingConfig {
  id              String   @id @default(uuid())
  userId          String   @unique
  selectedMode    String   @default("SPEAKER")
  inputSource     String   @default("ACOUSTIC_AIR")
  noiseGateDb     Float    @default(-45.0)
  lowPassCutoffHz Float    @default(800.0)
  latencyOffsetMs Int      @default(0)
  updatedAt       DateTime @updatedAt
}

/// LIV Golf tournament broadcast audio routing — singleton per realtime room scope.
model LivBroadcastAudioRouting {
  roomId           String   @id @default("liv-golf-tour-main-room")
  masterOutputMode String   @default("WORLD_MIX")
  onCourseMatrix   Json     @default("[]")
  commentaryTracks Json     @default("[]")
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}
